{
  "expo": {
    "name": "Blue Angels Care Mobile",
    "slug": "blue-angels-care-mobile",
    "version": "1.0.10",
    "orientation": "default",
    "icon": "./assets/bac-logo.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "org.blueangelscare.mobile",
      "buildNumber": "34",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to sign in faster and protect your account.",
        "NSLocationWhenInUseUsageDescription": "Blue Angels Care uses your location during check-in and check-out to verify visit GPS for service documentation.",
        "NSUserNotificationUsageDescription": "Blue Angels Care sends reminders and alerts for awake monitoring during active shifts.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "org.blueangelscare.mobile",
      "versionCode": 22,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "notification": {
      "icon": "./assets/bac-logo.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true
    },
    "extra": {
      "EXPO_PUBLIC_BAC_API_BASE_URL": "https://blueangelscareapi.onrender.com",
      "eas": {
        "projectId": "daffae30-51d9-482b-bde2-e91a65d7c160"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-notifications"
    ]
  }
}