{
  "expo": {
    "name": "Blue Angels Care Mobile",
    "slug": "blue-angels-care-mobile",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/bac-logo.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "org.blueangelscare.mobile",
      "buildNumber": "13",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to sign in faster and protect your account."
      }
    },
    "android": {
      "package": "org.blueangelscare.mobile"
      "versionCode": 13
    },
    "extra": {
      "eas": {
        "projectId": "daffae30-51d9-482b-bde2-e91a65d7c160"
      }
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"]
  }
}
